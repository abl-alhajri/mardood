# =============================================
# XYZTRADINGAE — environment template
# Copy to .env and fill in. Never commit .env.
# =============================================

# Claude (trading brain) — required for live signals.
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot — required for alerts and the /status, /positions,
# /signals, /portfolio command bot. If either is missing the trading
# loop still runs; alerts and command polling are simply disabled.
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=123456789

# Optional supplementary data sources.
HUGGINGFACE_API_KEY=hf_...
FINNHUB_API_KEY=...

# Persistent volume mount on Railway (e.g. /data). Falls back to ./memory
# locally if unset, so set this only in deployed environments.
DATA_DIR=/data
